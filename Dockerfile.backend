# Use python:3.12-slim as base image
FROM python:3.12.16-slim

# Prevent Python from writing .pyc files and enable unbuffered output
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# Install minimal runtime/build libraries (psycopg[binary] & pyarrow ship manylinux wheels)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . /app

# Production Compose runs API and worker containers as the unprivileged application user.
RUN useradd --uid 10001 --create-home finsight \
    && mkdir -p /app/static/data /app/static/uploads /app/static/tmp /app/static/evaluation \
    && chown -R finsight:finsight /app

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
