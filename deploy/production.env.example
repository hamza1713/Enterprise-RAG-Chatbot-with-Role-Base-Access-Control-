# Copy to deploy/production.env and provide real values locally. Never commit it.
JWT_SECRET=
ADMIN_PASSWORD=
POSTGRES_USER=finsight
POSTGRES_PASSWORD=
POSTGRES_DB=finsight
# DATABASE_URL=postgresql+psycopg://finsight:CHANGE_ME@postgres:5432/finsight
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=finsight-documents
S3_REGION=us-east-1
# S3_ENDPOINT_URL=http://rustfs:9000
GOOGLE_API_KEY=
COHERE_API_KEY=
CORS_ORIGINS=https://your-workspace.example.com
UVICORN_WORKERS=2
# Optional: override sidecar URL, trusted proxy CIDRs, or model defaults
# DOCLING_SERVE_URL=http://docling-serve:5001
# DOCLING_TIMEOUT_SECONDS=120
# EMBEDDING_DIMENSIONS=1536
# CONTEXTUAL_RETRIEVAL_ENABLED=true
# TRUSTED_PROXY_IPS=127.0.0.1/32,::1/128,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
# GEMINI_CHAT_MODEL=gemini-3.8-flash
# GEMINI_LIGHT_MODEL=gemini-3.5-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# COHERE_RERANK_MODEL=rerank-v3.5

# ── Observability & Compliance Governance ─────────────────────────────────────
LOG_FORMAT=json
OTEL_SERVICE_NAME=finsight-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://phoenix:4318
METRICS_ENABLED=true
# METRICS_AUTH_TOKEN=replace-with-strong-random-metrics-scrape-token
AUDIT_STORE_PROMPT_PREVIEW=true
