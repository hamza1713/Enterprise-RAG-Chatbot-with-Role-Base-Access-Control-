# FinSight — Environment Variables Template
# Copy this file to `.env` and fill in your API keys.

# ── Required ───────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_gemini_api_key_here

# ── Optional AI integrations ───────────────────────────────────────────────────
COHERE_API_KEY=                  # Cohere reranker (skip if unused)
LANGCHAIN_API_KEY=               # LangSmith tracing (skip if unused)

# ── PostgreSQL 17 + pgvector / pgvectorscale ──────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finsight
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/finsight

# ── Object Storage (S3-compatible: RustFS in Docker, AWS S3, or local dev vault) ─
STORAGE_BACKEND=s3               # Use "local" for disk-only unit testing
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=finsight-documents
S3_ACCESS_KEY=finsight-dev
S3_SECRET_KEY=finsight-dev-secret
S3_REGION=us-east-1

# ── Docling-Serve PDF/OCR Sidecar ─────────────────────────────────────────────
DOCLING_SERVE_URL=http://localhost:5001
DOCLING_TIMEOUT_SECONDS=120

# ── Security & Dual Auth (Local HttpOnly Cookie/Bearer + Optional OIDC PKCE) ──
# JWT_SECRET=             # Auto-generated if blank in dev; >=32 chars required in prod
# SESSION_SECRET=         # Ephemeral OIDC/SessionMiddleware signing secret; defaults to JWT_SECRET
COOKIE_SECURE=false       # Set true behind HTTPS in production
FRONTEND_URL=http://localhost:5173
OIDC_ENABLED=false
OIDC_PROVIDER_NAME=Enterprise SSO
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/auth/oidc/callback
OIDC_SCOPES=openid email profile
OIDC_ROLE_CLAIM=groups
OIDC_ROLE_MAP_JSON={}

# ── OpenFGA ReBAC Sidecar ─────────────────────────────────────────────────────
OPENFGA_API_URL=http://localhost:8080
OPENFGA_STORE_NAME=finsight
OPENFGA_API_TOKEN=

# ── Agentic Guardrails & Orchestration ────────────────────────────────────────
PROMPT_INJECTION_GUARD_MODE=filter_and_flag
SQL_MAX_RETRIES=2
AGENT_MAX_LOOPS=1

# ── Default user passwords (change before production!) ────────────────────────
ADMIN_PASSWORD=admin123
MARKETING_PASSWORD=marketing123
HR_PASSWORD=hr123
FINANCE_PASSWORD=finance123
ENGINEERING_PASSWORD=engineering123

# ── Gemini Models, Embeddings & Contextual Retrieval ──────────────────────────
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_LIGHT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536
CONTEXTUAL_RETRIEVAL_ENABLED=true
COHERE_RERANK_MODEL=rerank-v3.5

# ── Proxy Trust (comma-separated CIDR blocks allowed for X-Forwarded-For) ─────
TRUSTED_PROXY_IPS=127.0.0.1/32,::1/128

# ── Redis / Caching, Rate Limiting & Taskiq Workers ───────────────────────────
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=true
CACHE_TTL_SECONDS=3600
UVICORN_WORKERS=2

# ── Observability, Telemetry & Audit Compliance ───────────────────────────────
LOG_FORMAT=text                  # Use "json" in production
OTEL_SERVICE_NAME=finsight-api
OTEL_EXPORTER_OTLP_ENDPOINT=     # e.g. http://localhost:4318 when --profile observability is up
METRICS_ENABLED=true
METRICS_AUTH_TOKEN=
AUDIT_STORE_PROMPT_PREVIEW=true
